# AbyFlow Environment Configuration Example
# Copy this file to .env and replace placeholder values with your actual configuration.

# Environment: 'development', 'testing', or 'production'
FLASK_ENV=development

# PostgreSQL Database Configuration
POSTGRES_USER=abyflow_user
POSTGRES_PASSWORD=replace_with_a_secure_database_password
POSTGRES_DB=abyflow_db
DATABASE_URL=postgresql://abyflow_user:replace_with_a_secure_database_password@db:5432/abyflow_db

# Redis Message Broker
REDIS_URL=redis://redis:6379/0

# JWT Security
JWT_SECRET_KEY=replace_with_a_random_64_char_secret_key
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Stripe Integration (Test Mode or Live Mode)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Application Base URL (Used for Stripe Checkout redirect callbacks)
# Local development: http://localhost:5000
# Production EC2: https://yourdomain.com
APP_BASE_URL=http://localhost:5000

# AI assistant and RAG
# Leave blank only when using the explicitly enabled development mock client.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.0
AI_REQUEST_TIMEOUT=15.0
AI_EMBEDDING_MODEL=text-embedding-3-small
# Set true only for local development without an OpenAI key.
AI_ALLOW_MOCK_EMBEDDINGS=true

# Flask signing secret (separate from the JWT signing key)
SECRET_KEY=replace_with_a_random_secret_key
