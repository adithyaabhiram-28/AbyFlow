# AbyFlow Environment Configuration Example
# Copy this file to .env and replace placeholder values with your actual configuration.

# Environment: 'development', 'testing', or 'production'
FLASK_ENV=development

# PostgreSQL Database Configuration
POSTGRES_USER=abyflow_user
POSTGRES_PASSWORD=replace_with_a_secure_database_password
POSTGRES_DB=abyflow_db
DATABASE_URL=postgresql://abyflow_user:replace_with_a_secure_database_password@db:5432/abyflow_db

# Redis Message Broker
REDIS_URL=redis://redis:6379/0

# JWT Security
JWT_SECRET_KEY=replace_with_a_random_64_char_secret_key
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Stripe Integration (Test Mode or Live Mode)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Application Base URL (Used for Stripe Checkout redirect callbacks)
# Local development: http://localhost:5000
# Production EC2: https://yourdomain.com
APP_BASE_URL=http://localhost:5000
